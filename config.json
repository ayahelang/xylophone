{
  "name": "Silver Xylophone",
  "version": "2.0.0",
  "description": "Lightweight responsive browser xylophone with Google Sheets gallery.",
  "features": [
    "8-note C major xylophone",
    "Mouse/touch/keyboard play",
    "Volume control",
    "Octave 3-5",
    "Selectable oscillator tone",
    "Optional reverb",
    "Dark/light mode",
    "Record & save melody to Google Sheets",
    "Public gallery with play, like, comment",
    "Delete with owner password"
  ],
  "keyboard": {
    "A": "C",
    "S": "D",
    "D": "E",
    "F": "F",
    "G": "G",
    "H": "A",
    "J": "B",
    "K": "C"
  },
  "deployment": {
    "platform": "GitHub Pages",
    "backend": "Google Apps Script + Sheets",
    "build_step": false
  }
}
